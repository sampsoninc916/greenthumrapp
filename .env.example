# Public frontend configuration. This endpoint should point at your own backend,
# which creates Stripe Checkout Sessions using STRIPE_SECRET_KEY on the server.
# Never put Stripe secret keys (sk_...) in REACT_APP_* variables or any client bundle.
REACT_APP_STRIPE_CHECKOUT_ENDPOINT=https://your-api.example.com/api/stripe/create-checkout-session

# Server-only example (do not prefix with REACT_APP_ and do not commit real values):
# STRIPE_SECRET_KEY=sk_test_your_server_only_key
# STRIPE_WEBHOOK_SECRET=whsec_your_server_only_webhook_secret
